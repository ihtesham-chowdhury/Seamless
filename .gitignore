# Build output — note these are unanchored so they match app/build too, not just the root.
build/
.gradle/
.kotlin/
/captures
.externalNativeBuild
.cxx

# IDE
*.iml
.idea/
*.hprof

# Machine-specific: points at this computer's SDK.
local.properties

# Signing material. None of this may ever be committed.
keystore.properties
*.jks
*.keystore
release/

# The maintainer's local release helper and what it writes. The script hard-codes this machine's
# JDK, SDK and keystore paths, so it is useless to anyone else and publishes a home directory to
# everyone; the fingerprint file is a build artefact, not source.
release-seamless.ps1
seamless-key-fingerprint.txt

# Build artifacts
*.apk
*.aab
*.ap_
*.dex

.DS_Store
Thumbs.db

# Python bytecode from the scripts in tools/.
__pycache__/
