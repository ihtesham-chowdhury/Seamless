<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ uses the granular media permission; older releases use the broad one. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Required to attach the loudness effect used for volume above 100%. This is a normal
      permission: it is granted at install, shows no prompt, and gives access to no data.
      It does not permit recording — that would be RECORD_AUDIO, which is not requested.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Added in 0.2.0, for one feature and one only: looking up a subtitle when the user asks for
      one by name. It is worth being blunt about what this changes, because "offline-first" was
      and remains the point of this app.

      What it does not do. Nothing contacts the network when a video is opened, when the library
      is scanned, when the app starts, or on any schedule. There is no analytics, no crash
      reporting, no update check and no advertising identifier — there is no code here that could
      do any of those, and the whole of the app's networking is one file, util/Http.kt, which
      refuses plain HTTP and refuses to run on the main thread.

      What it does. From the subtitle panel, "Find subtitles" sends the video's title, year,
      episode number and a 64-bit fingerprint of the file's first and last 64 KiB to the subtitle
      provider configured in Settings. Off by default, and inert until the user supplies their own
      API key. Once a subtitle is downloaded it is kept, and playback never needs the network
      again. See PRIVACY.md and docs/SUBTITLES.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The launcher icon is a plain drawable, not the adaptive pair in mipmap-anydpi-v26.

      Every launcher tried drew a soft rounded plate behind the adaptive version, in default
      settings, including Nova, Smart Launcher and crDroid; swapping in an icon-pack icon —
      an ordinary non-adaptive drawable — removed it on all three. That is the mask shadow:
      a launcher generates it from the adaptive icon's mask path rather than from the
      artwork, so a transparent background layer leaves it on show and no change to the
      drawing can take it away.

      The trade is Android 13+ themed icons, which require an adaptive icon. To go back:
          android:icon="@mipmap/ic_launcher"
          android:roundIcon="@mipmap/ic_launcher_round"
    -->
    <application
        android:name=".SeamlessApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_unmasked"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Seamless"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.library.FolderVideosActivity"
            android:exported="false" />

        <activity
            android:name=".ui.help.HelpActivity"
            android:exported="false"
            android:theme="@style/Theme.Seamless.Page" />

        <!-- The story behind the app: a page of its own, on its own ground. -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Seamless.Page.About" />

        <!-- The shorts feed. Locked to portrait, no landscape, immersive. -->
        <activity
            android:name=".ui.shorts.ShortsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Seamless.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!--
          The conventional player, used for long-form / landscape material.

          taskAffinity="" is what makes "open from a file manager, then close" return to the
          file manager instead of dumping you in this app's library. Many apps launch a
          viewer with FLAG_ACTIVITY_NEW_TASK, and Android then places it in whichever task
          shares its affinity — by default this app's own. With no affinity it gets its own
          task, so finishing pops straight back to whatever opened it. Launches from inside
          the app are unaffected: they carry no NEW_TASK flag, so they stay in the current
          task and Back still returns to the folder.
        -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Seamless.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
          Lets a video that a file manager handed over as a bare file path be shared on. A path
          cannot leave the app (Android throws the moment one is put in an outgoing intent), so
          when the library has no entry for the file, the share goes out through this provider
          instead. It serves only what Seamless grants, one file at a time, and is not exported.
          See ui/common/VideoShare and res/xml/shared_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>
    </application>
</manifest>
