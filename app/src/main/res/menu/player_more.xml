<?xml version="1.0" encoding="utf-8"?>
<!--
  The overflow, and what is deliberately not in it.

  Subtitles used to be here as well as on the CC button, because the button only appeared once a
  video turned out to have captions and there had to be some way to go looking for one. The
  button is now always present, so the menu entry became the same thing in a second place under
  the same name — which is worse than either alone: two doors to one room teach the user that
  neither is the door.

  Audio stays, hidden unless the file has more than one track, because a menu item that opens a
  list of one is a dead end.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/action_audio" android:title="@string/audio_tracks" />
    <item android:id="@+id/action_info" android:title="@string/action_info" />
    <item android:id="@+id/action_share" android:title="@string/action_share" />
</menu>
