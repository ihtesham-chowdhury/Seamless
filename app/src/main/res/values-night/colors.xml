<resources>
    <!-- See values/colors.xml. Light on dark, and a little stronger: a translucent white
         needs more of itself than a translucent black to read at the same weight. -->
    <color name="glass_fill_top">#26FFFFFF</color>
    <color name="glass_fill_bottom">#14FFFFFF</color>
    <color name="glass_stroke">#2EFFFFFF</color>

    <!-- See values/colors.xml. A dark pane rather than a light one, lifted just off the
         background so the capsule has an edge without needing a hard border. -->
    <color name="nav_fill_top">#F0262429</color>
    <color name="nav_fill_bottom">#F01B1A1F</color>
    <color name="nav_stroke">#14FFFFFF</color>

    <!-- See values/colors.xml. Dark enough to sit back, light enough that the knob has an edge. -->
    <color name="switch_track_off">#FF3A3A3F</color>
</resources>
