<?xml version="1.0" encoding="utf-8"?>
<!--
  The play disc: the same glass as its neighbours, brighter and with a stronger edge, because it
  is the button that matters and a transport row should say which one that is before it is read.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#26000000" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#1FFFFFFF"
                        android:startColor="#52FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#66FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
