<?xml version="1.0" encoding="utf-8"?>
<!-- Same frosted idea as the toolbar capsule, but always dark: a tip can appear over video. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient android:angle="270" android:endColor="#F01A1A1F" android:startColor="#F02A2A32" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
