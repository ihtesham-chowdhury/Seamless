<?xml version="1.0" encoding="utf-8"?>
<!--
  A preset speed's pill: faint glass at rest, solid white when it is the speed playing.
  The ripple's mask is the pill itself, so pressing one never flashes a rectangle.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#F2FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#1FFFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#1FFFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
