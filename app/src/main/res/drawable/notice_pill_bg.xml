<?xml version="1.0" encoding="utf-8"?>
<!--
  The subtitle notice's pill: dark glass, a touch lighter along its top, with a faint light edge.

  Nearly opaque, unlike the transport discs, because it carries two lines of text that have to be
  read over whatever the film is showing at that moment, and a notice you cannot read has not
  said anything.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#E61C1C21" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#1AFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#29FFFFFF" />
        </shape>
    </item>
</layer-list>
