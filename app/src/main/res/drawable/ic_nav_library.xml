<?xml version="1.0" encoding="utf-8"?>
<!--
  Library: a softly rounded folder with a clear tab, and nothing else inside it.

  One of three drawn together for the navigation capsule: Library, Shorts and Settings share a 2dp
  line, round joins and caps, and the same optical size, so the three read as one family rather than
  a folder from one set, a logo from another and a gear from a third. The weight matches the CC
  control in the player, which is the point — the capsule is meant to look like a larger cousin of
  those controls. Tinted where it is used; the glyph is the same when its tab is selected, only
  brighter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M5,5 H9.17 A2,2 0,0 1,10.58 5.59 L12,7 H19 A2,2 0,0 1,21 9 V17 A2,2 0,0 1,19 19 H5 A2,2 0,0 1,3 17 V7 A2,2 0,0 1,5 5 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
</vector>
