<?xml version="1.0" encoding="utf-8"?>
<!--
  Undo, as a button that looks like one.

  A small light pill inside the dark one, rather than a word in capitals floating at the end of a
  line. It is the only thing on the notice that can be pressed, so it is the only thing given a
  surface; the ripple is masked to the pill so a press never flashes a rectangle.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#29FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</ripple>
