<?xml version="1.0" encoding="utf-8"?>
<!--
  The glass the transport buttons sit in.

  A translucent capsule, lighter at the top than at the bottom, with a faint light edge, over a
  thin dark underlay. The underlay is not decoration: white glass over a white sky is invisible,
  and that layer is what keeps the capsule an object over any frame. This is not a blur — Android
  cannot blur what is behind an in-app view; see glass_pill_bg.xml — but a gradient and an edge
  are most of what the eye reads as glass.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#2E000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:endColor="#0FFFFFFF"
                android:startColor="#2EFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
