<?xml version="1.0" encoding="utf-8"?>
<!--
  The accent island that sits under the selected tab.

  The accent, with a soft highlight that is brightest along the top edge and gone by the middle,
  and a faint light rim. The highlight is what turns a flat coloured capsule into something that
  looks lit, the same trick the glass surfaces use; the rim keeps the island's edge crisp against
  a glass capsule of a similar darkness.

  The first layer is a plain rounded rectangle on purpose. A layer list takes its outline from its
  first layer, and the outline is what the island's tinted shadow — its glow — is cast from.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/nav_island" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#38FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
