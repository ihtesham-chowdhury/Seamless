<?xml version="1.0" encoding="utf-8"?>
<!--
  The navigation capsule's surface.

  A dark translucent material only just lighter than the page, not a grey pill: a very slight
  vertical tonal change, a 1dp edge at a few percent, and a top highlight so faint that it is only
  missed when it is taken away. It is not a blur — Android cannot blur what is behind an in-app
  view — and it does not try to look like frosted glass; what it borrows from glass is the way a
  surface catches light along its top. The shadow comes from the view's elevation, not from here.

  On the light theme the same layers give a soft lifted white surface; the highlight disappears
  into it, and the shadow carries the lift instead.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/nav_fill_bottom"
                android:startColor="@color/nav_fill_top" />
            <stroke
                android:width="1dp"
                android:color="@color/nav_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#0DFFFFFF" />
        </shape>
    </item>
</layer-list>
