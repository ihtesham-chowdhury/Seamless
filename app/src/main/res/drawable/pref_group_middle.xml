<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings row background: a row with a row above and below it.

  Which corners are rounded is decided in settings.xml, by pointing each preference
  at the matching row layout. That is static on purpose: the groups do not change at
  runtime, and asking the adapter where a row sits in its section would mean
  reimplementing what the XML already says plainly.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="?attr/colorSurfaceContainer" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="?attr/colorSurfaceContainer" />
        </shape>
    </item>
</ripple>
