<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings row background: a row with a row above and below it.

  Which corners are rounded is decided in settings.xml, by pointing each preference
  at the matching row layout. That is static on purpose: the groups do not change at
  runtime, and asking the adapter where a row sits in its section would mean
  reimplementing what the XML already says plainly.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="0dp" />
                    <solid android:color="?attr/colorSurfaceContainer" />
                </shape>
            </item>

            <!--
              A hairline where this row meets the one above it, inset so it stops short of the
              card's own edges. Without it a group of five settings is one unbroken slab and
              the eye has nothing to count by; with a full-width rule it would look like the
              card had been cut into pieces. The first row of a group has no line, because
              there is nothing above it inside the card.
            -->
            <item
                android:gravity="top"
                android:height="1dp"
                android:left="18dp"
                android:right="18dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorOutlineVariant" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="?attr/colorSurfaceContainer" />
        </shape>
    </item>
</ripple>
