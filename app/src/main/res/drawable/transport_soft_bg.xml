<?xml version="1.0" encoding="utf-8"?>
<!--
  A button raised out of a pale surface: a shadow pushed down behind it, and a face lit from
  above. The dark room's version is in drawable-night.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F000000">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="#2E8A8FA0" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#FFE7E9EF"
                        android:startColor="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
