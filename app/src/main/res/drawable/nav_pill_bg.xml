<?xml version="1.0" encoding="utf-8"?>
<!--
  The frosted style's selected pill: the accent colour, flat, the way Orion Store's is.

  A faint light across the top and a hairline rim keep it from looking printed on, and nothing
  more. Its glow is not here: the pill's elevation casts a shadow tinted with its own colour, set
  in FloatingNavBar, which is what gives it the soft coloured halo underneath.

  The first layer is a plain rounded rectangle on purpose, because a layer list takes its outline
  from its first layer and that outline is what the glow is cast from.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/nav_island" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:centerColor="#05FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#24FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
