<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings, in groups.

  This screen used to be one flat run of rows under thin headings, which made it read as a
  list of every switch in the app rather than as a set of decisions about particular things.
  Each group is now a card: the heading says what it is for, and the card's edge says where
  it ends. The order runs from what people change often to what they change once.

  Every row carries an icon on a small disc, and every switch is the pill in pref_switch.xml.
  The icons are Material's, the family the player's own controls come from, so the settings
  screen and the player look like one product; the switches carry the accent so "on" is said
  in the colour the user chose.

  android:layout on every entry is what draws those cards — the row layouts differ only in
  which corners they round, and each preference names the one that matches its place in its
  group. Adding, removing or moving a row means fixing its neighbours' layouts too. That is
  the price of a static answer, and it is cheaper than the alternative, which is teaching the
  adapter to work out group boundaries it already has written down here.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:layout="@layout/pref_category"
        android:title="@string/settings_appearance">

        <ListPreference
            android:defaultValue="SYSTEM"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:key="theme_mode"
            android:icon="@drawable/ic_pref_theme"
            android:layout="@layout/pref_row_top"
            android:title="@string/settings_theme_title"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:key="accent_color"
            android:icon="@drawable/ic_pref_palette"
            android:layout="@layout/pref_row_middle"
            android:title="@string/settings_accent_title" />

        <!-- Three looks for the same three tabs. Applied to the capsule underneath this screen
             as soon as it is picked, so the choice is made by seeing it. -->
        <ListPreference
            android:defaultValue="GLASS"
            android:entries="@array/nav_style_entries"
            android:entryValues="@array/nav_style_values"
            android:key="nav_style"
            android:icon="@drawable/ic_pref_nav"
            android:layout="@layout/pref_row_bottom"
            android:title="@string/settings_nav_style_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/pref_category"
        android:title="@string/settings_shorts">

        <!--
          The source lives here rather than on the Shorts tab. Choosing it is a decision you
          make once; being asked again on the way into every session is a toll, not a choice.
        -->
        <ListPreference
            android:defaultValue="WHOLE_DEVICE"
            android:entries="@array/shorts_source_entries"
            android:entryValues="@array/shorts_source_values"
            android:key="shorts_source"
            android:icon="@drawable/ic_pref_source"
            android:layout="@layout/pref_row_top"
            android:title="@string/settings_shorts_source_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/pref_switch"
            android:defaultValue="false"
            android:key="shorts_include_short_landscape"
            android:icon="@drawable/ic_pref_landscape"
            android:layout="@layout/pref_row_middle"
            android:summary="@string/settings_shorts_landscape_summary"
            android:title="@string/shorts_filter_landscape" />

        <!--
          Deliberately not keyed on shorts_max_landscape_seconds. A ListPreference stores a
          String and Prefs reads that setting as an Int, so sharing the key would put a
          String where an Int is expected and throw the moment anything read it back. The
          fragment mirrors this into the real key instead.
        -->
        <ListPreference
            android:defaultValue="30"
            android:entries="@array/shorts_length_entries"
            android:entryValues="@array/shorts_length_values"
            android:key="shorts_max_landscape_label"
            android:icon="@drawable/ic_pref_timer"
            android:layout="@layout/pref_row_middle"
            android:title="@string/shorts_max_length_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/pref_switch"
            android:defaultValue="true"
            android:key="shorts_auto_advance"
            android:icon="@drawable/ic_pref_autoplay"
            android:layout="@layout/pref_row_middle"
            android:summary="@string/settings_autoadvance_summary"
            android:title="@string/settings_autoadvance_title" />

        <ListPreference
            android:defaultValue="FIT"
            android:entries="@array/resize_entries"
            android:entryValues="@array/resize_values"
            android:key="shorts_resize_mode"
            android:icon="@drawable/ic_aspect_ratio"
            android:layout="@layout/pref_row_bottom"
            android:title="@string/settings_shorts_resize_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/pref_category"
        android:title="@string/settings_playback">

        <ListPreference
            android:defaultValue="FIT"
            android:entries="@array/resize_entries"
            android:entryValues="@array/resize_values"
            android:key="player_resize_mode"
            android:icon="@drawable/ic_pref_fit"
            android:layout="@layout/pref_row_top"
            android:title="@string/settings_player_resize_title"
            app:useSimpleSummaryProvider="true" />

        <!-- Four hands for the same timeline; the waveform is the one it has always had. -->
        <ListPreference
            android:defaultValue="WAVE"
            android:entries="@array/seek_bar_entries"
            android:entryValues="@array/seek_bar_values"
            android:key="seek_bar_style"
            android:icon="@drawable/ic_pref_seek"
            android:layout="@layout/pref_row_middle"
            android:title="@string/settings_seek_bar_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="FOLLOW_VIDEO"
            android:entries="@array/orientation_entries"
            android:entryValues="@array/orientation_values"
            android:key="orientation_mode"
            android:icon="@drawable/ic_pref_rotation"
            android:layout="@layout/pref_row_middle"
            android:title="@string/settings_orientation_title"
            app:useSimpleSummaryProvider="true" />

        <!--
          Same String-versus-Int split as the shorts length above, and mirrored the same way.
          This was a SeekBarPreference, which brings its own row layout with the slider built
          into it and so could not join a card without forking that layout as well. A handful
          of sensible values is a better question anyway: nobody wants seventeen minutes.

          No useSimpleSummaryProvider here, deliberately: the fragment writes a summary that
          says what the number means rather than repeating it, and setSummary throws outright
          on a preference that has a summary provider. Having both is what crashed this
          screen on open.
        -->
        <ListPreference
            android:defaultValue="10"
            android:entries="@array/resume_entries"
            android:entryValues="@array/resume_values"
            android:key="resume_minutes_label"
            android:icon="@drawable/ic_pref_history"
            android:layout="@layout/pref_row_middle"
            android:title="@string/settings_resume_title" />

        <Preference
            android:key="clear_resume"
            android:icon="@drawable/ic_pref_sweep"
            android:layout="@layout/pref_row_bottom"
            android:title="@string/settings_clear_resume" />
    </PreferenceCategory>

    <!--
      Subtitles.

      How they *look* is not here, deliberately. Size, weight and position are decided by looking
      at them over the film, so they live on the player's own appearance panel, one tap from the CC
      button, where every change can be seen as it is made. What is here is the part you set once.
    -->
    <PreferenceCategory
        android:layout="@layout/pref_category"
        android:title="@string/settings_subtitles">

        <ListPreference
            android:defaultValue="en"
            android:entries="@array/subtitle_language_entries"
            android:entryValues="@array/subtitle_language_values"
            android:key="subtitle_language"
            android:icon="@drawable/ic_pref_language"
            android:layout="@layout/pref_row_top"
            android:title="@string/settings_subtitle_language_title"
            app:useSimpleSummaryProvider="true" />

        <!-- The only switch in the app that turns networking on. Off, and documented in
             PRIVACY.md; with no key set below it, flipping it still reaches nothing. -->
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/pref_switch"
            android:defaultValue="false"
            android:key="subtitle_online"
            android:icon="@drawable/ic_pref_cloud"
            android:layout="@layout/pref_row_middle"
            android:summary="@string/settings_subtitle_online_summary"
            android:title="@string/settings_subtitle_online_title" />

        <!-- No summary and no provider on either of these two: the fragment writes what is
             actually stored, and setSummary throws on a preference that has a provider. -->
        <Preference
            android:key="subtitle_api_key"
            android:icon="@drawable/ic_pref_key"
            android:layout="@layout/pref_row_middle"
            android:title="@string/settings_subtitle_key_title" />

        <Preference
            android:key="subtitle_account"
            android:icon="@drawable/ic_pref_account"
            android:layout="@layout/pref_row_middle"
            android:title="@string/settings_subtitle_account_title" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/pref_switch"
            android:defaultValue="true"
            android:key="subtitle_auto_apply"
            android:icon="@drawable/ic_pref_sparkle"
            android:layout="@layout/pref_row_middle"
            android:summary="@string/settings_subtitle_auto_summary"
            android:title="@string/settings_subtitle_auto_title" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/pref_switch"
            android:defaultValue="true"
            android:key="subtitle_save_beside"
            android:icon="@drawable/ic_pref_save"
            android:layout="@layout/pref_row_middle"
            android:summary="@string/settings_subtitle_beside_summary"
            android:title="@string/settings_subtitle_beside_title" />

        <Preference
            android:key="subtitle_clear"
            android:icon="@drawable/ic_pref_download"
            android:layout="@layout/pref_row_bottom"
            android:title="@string/settings_subtitle_clear" />
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/pref_category"
        android:title="@string/settings_gestures">

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/pref_switch"
            android:defaultValue="true"
            android:key="swipe_down_to_close"
            android:icon="@drawable/ic_pref_swipe_down"
            android:layout="@layout/pref_row_top"
            android:summary="@string/settings_swipe_close_summary"
            android:title="@string/settings_swipe_close_title" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/pref_switch"
            android:defaultValue="false"
            android:key="external_portrait"
            android:icon="@drawable/ic_pref_portrait"
            android:layout="@layout/pref_row_middle"
            android:summary="@string/settings_external_portrait_summary"
            android:title="@string/settings_external_portrait_title" />

        <!-- How you get *out* of the player's screen lock: a gesture, so it belongs with the
             other gestures rather than with the privacy locks, which it has nothing to do
             with. -->
        <ListPreference
            android:defaultValue="SLIDER"
            android:entries="@array/unlock_entries"
            android:entryValues="@array/unlock_values"
            android:key="unlock_method"
            android:icon="@drawable/ic_lock_open"
            android:layout="@layout/pref_row_bottom"
            android:title="@string/settings_unlock_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/pref_category"
        android:title="@string/settings_privacy">

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/pref_switch"
            android:defaultValue="false"
            android:key="app_lock"
            android:icon="@drawable/ic_pref_shield"
            android:layout="@layout/pref_row_top"
            android:summary="@string/settings_app_lock_summary"
            android:title="@string/settings_app_lock_title" />

        <Preference
            android:key="locked_folders"
            android:icon="@drawable/ic_lock"
            android:layout="@layout/pref_row_middle"
            android:title="@string/settings_locked_folders_title" />

        <Preference
            android:key="hidden_folders"
            android:icon="@drawable/ic_hide"
            android:layout="@layout/pref_row_bottom"
            android:title="@string/settings_hidden_folders_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/pref_category"
        android:title="@string/settings_help_title">

        <Preference
            android:key="help"
            android:icon="@drawable/ic_pref_touch"
            android:layout="@layout/pref_row_top"
            android:summary="@string/settings_help_summary"
            android:title="@string/settings_help_title" />

        <Preference
            android:key="reset_tips"
            android:icon="@drawable/ic_tip"
            android:layout="@layout/pref_row_middle"
            android:title="@string/settings_reset_tips" />

        <Preference
            android:key="version"
            android:icon="@drawable/ic_info"
            android:layout="@layout/pref_row_bottom"
            android:selectable="false"
            android:title="@string/settings_version_title" />
    </PreferenceCategory>
</PreferenceScreen>
