<resources>
    <color name="black">#FF000000</color>
    <color name="scrim">#99000000</color>

    <!--
      The frosted capsule behind the toolbar icons. Dark and translucent on a light
      background; the values-night file inverts this. The two fill colours are the ends of a
      vertical gradient, and the difference between them is what suggests a lit surface.
    -->
    <color name="glass_fill_top">#14000000</color>
    <color name="glass_fill_bottom">#0A000000</color>
    <color name="glass_stroke">#1A000000</color>

    <!--
      The floating navigation capsule. Denser than the toolbar's: the list scrolls underneath
      this one, so the labels have to stay readable over whatever happens to be passing.
    -->
    <color name="nav_fill_top">#F5FFFFFF</color>
    <color name="nav_fill_bottom">#EEF6F2FA</color>
    <color name="nav_stroke">#14000000</color>

    <!-- A settings switch that is off: a light neutral the white knob still stands out against.
         On is the accent; see color/pref_switch_track.xml. -->
    <color name="switch_track_off">#FFD1D1D6</color>
</resources>
