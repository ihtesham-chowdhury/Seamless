<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Seamless" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Required by PreferenceFragmentCompat; Material3 does not supply it. -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <!--
      The window a floating panel lives in.

      Not a bottom sheet. The subtitle panel is a card that floats over the picture, clear of
      every edge, and a BottomSheetDialog is bottom-anchored by construction: it can be given a
      margin but it still belongs to the bottom of the screen, and it still reads as a drawer
      pulled out of the frame rather than as something resting on top of it.

      windowIsFloating with a transparent background is what leaves the panel's own rounded,
      translucent surface as the only thing drawn. The window animation is null on purpose —
      the content view is animated instead, so the scale can be pivoted on the corner the
      control that opened it sits in. Material3's dialog parent is kept because the appearance
      panel puts real Material sliders and toggle buttons inside this window.
    -->
    <style name="Theme.Seamless.FloatingSheet" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Player surfaces: always black, never a light background flashing behind video. -->
    <style name="Theme.Seamless.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!--
      A page you read rather than a place you go: Gestures and tips, and About.

      They open with a short fade over Settings instead of the system's slide, which is the
      navigation gesture for moving somewhere else. Both the arriving and the leaving animations
      are taken from the page's own theme, so nothing else in the app changes how it moves.
    -->
    <style name="Theme.Seamless.Page" parent="Theme.Seamless">
        <item name="android:windowAnimationStyle">@style/Animation.Seamless.Page</item>
    </style>

    <!-- About paints its own ground; the window matches it so nothing lighter shows first. -->
    <style name="Theme.Seamless.Page.About" parent="Theme.Seamless.Page">
        <item name="android:windowBackground">@color/page_ground</item>
    </style>

    <style name="Animation.Seamless.Page" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/page_close_exit</item>
    </style>
</resources>
