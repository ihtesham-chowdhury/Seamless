    <string name="tip_library">Long press a folder to pin it to the top, hide it, lock it, or change its thumbnail.</string>
    <string name="tip_folder">Long press a video to rename, move, share or delete it. Pin one to keep it at the top.</string>
    <string name="tip_shorts">Swipe up for the next clip. Drag sideways for brightness on the left, volume on the right.</string>
    <string name="tip_player">Drag up and down for brightness and volume. Drag down from the top to close. Hold for 2x.</string>

