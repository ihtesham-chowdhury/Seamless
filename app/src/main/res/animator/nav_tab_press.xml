<?xml version="1.0" encoding="utf-8"?>
<!--
  A navigation tab under the finger: it gives a little, and dims a little, and comes back.

  In place of a Material ripple. A ripple spreading across a floating capsule reads as a system
  button being pressed; a tab that compresses slightly reads as a surface being touched, which is
  what the rest of this player's controls feel like. Scale and alpha only, both handled on the
  render thread, and quick in both directions — slower on the way back so the release is felt.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="90"
                android:propertyName="scaleX"
                android:valueTo="0.94"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="90"
                android:propertyName="scaleY"
                android:valueTo="0.94"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="90"
                android:propertyName="alpha"
                android:valueTo="0.8"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="160"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="160"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="160"
                android:propertyName="alpha"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
