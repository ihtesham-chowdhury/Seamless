<?xml version="1.0" encoding="utf-8"?>
<!--
  What the search found, when it found more than one plausible answer.

  Four states in one panel — searching, a list, nothing found, something went wrong — because
  they are four answers to the same question and moving between them should not move the panel.
  The title says what was searched for, so a wrong guess at the film's name is visible
  immediately rather than after downloading the wrong subtitles for it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <com.seamless.player.ui.common.CappedColumn
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_glass_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_pad_horizontal"
        android:paddingTop="@dimen/sheet_pad_top"
        android:paddingEnd="@dimen/sheet_pad_horizontal"
        android:paddingBottom="@dimen/sheet_pad_bottom">

        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/subtitle_find"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/sheet_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subheading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:textColor="#8AFFFFFF"
            android:textSize="12sp" />

        <!-- The searching state. A row rather than a spinner in the middle of an empty panel,
             so the panel is the same height before and after. -->
        <LinearLayout
            android:id="@+id/searching"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="14dp"
                android:indeterminateTint="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_searching"
                android:textColor="#C7FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/list_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#C7FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!--
          Only appears when something actually went wrong, and it is the difference between a
          bug that can be fixed and one that can only be described. A subtitle search fails on
          someone else's phone, network and account; without the exchange in hand there is
          nothing to go on but "it did not work".
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_details"
            style="@style/Widget.Seamless.SheetToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:text="@string/subtitle_copy_details"
            android:visibility="gone" />
    </com.seamless.player.ui.common.CappedColumn>
</FrameLayout>
