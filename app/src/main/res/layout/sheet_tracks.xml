<?xml version="1.0" encoding="utf-8"?>
<!--
  The panel the CC button opens: "Pure / Minimal".

  A card floating over the picture, not a sheet pulled out of the bottom of it. It is inset on
  every side, rounded all round, and translucent, so the film keeps playing visibly around it.
  What the user is doing here is choosing a track for something they are watching, and the thing
  they are watching should not disappear behind a grey card while they do it.

  The shape is three bands separated by hairlines and nothing else:

      Subtitles                    X
      ───────────────────────────
      (o) English      Downloaded    [bin]
      ( ) English      In this video
      ───────────────────────────
      [search]  Find subtitles          >
      [folder]  Choose subtitle file    >
      ───────────────────────────
      Aa        Appearance               >

  No grabber — that is a bottom sheet's affordance and this does not drag. No coloured chips,
  no boxes round the rows, no icon on every line. The radio says which one is on, the second
  line says where it came from, and everything else is a hairline.

  **Only the tracks scroll**, and the cap on how tall they may get is a percentage of the
  screen that differs by orientation. Everything used to be one column of wrap_content, so a
  file with five subtitle tracks pushed Find subtitles, Choose subtitle file and Appearance off
  the bottom — present, but below the fold of a panel that had no fold. That is what "the
  appearance settings disappear once I add a subtitle" was.

  Both lists are filled at runtime. How many subtitle tracks a file has is a property of the
  file, and the actions differ between the two players — the feed has no online search — so
  declaring a fixed set of rows here would mean a second layout that differed only in which
  rows it hid.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <com.seamless.player.ui.common.CappedColumn
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_glass_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_pad_horizontal"
        android:paddingTop="@dimen/sheet_pad_top"
        android:paddingEnd="@dimen/sheet_pad_horizontal"
        android:paddingBottom="@dimen/sheet_pad_bottom">

        <!-- Title and a way out. The close button is here rather than only on the scrim,
             because the scrim is the film: aiming at it means aiming at what you are
             watching. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/sheet_title_size"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/sheet_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ripple_borderless_circle"
                android:contentDescription="@string/action_close"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="#8AFFFFFF" />
        </LinearLayout>

        <View
            android:id="@+id/header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="#1FFFFFFF" />

        <!--
          Nothing to choose from. The mark rather than a bare sentence: an empty panel is the
          one moment there is room for the app to have a face, and the sentence underneath
          still says what to do next.
        -->
        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_subtitles_mark" />

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#A6FFFFFF"
                android:textSize="@dimen/sheet_detail_size" />
        </LinearLayout>

        <!--
          wrap_content *and* a weight, which is the combination that shrinks. A height of 0dp
          with a weight collapses to nothing inside a wrap_content parent, because the parent
          has no spare height to hand out; wrap_content measures naturally first and then gives
          height back when the column overflows.
        -->
        <ScrollView
            android:id="@+id/rows_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Hidden when there is nothing below it, so the panel does not end on a line. -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#1FFFFFFF" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!--
          A second hairline, and the whole reason Appearance sits below it: the panel answers
          "what am I watching" above the line and "how does it look" below, and the second
          question is not the one anyone opened this to ask.
        -->
        <View
            android:id="@+id/footer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#1FFFFFFF" />

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.seamless.player.ui.common.CappedColumn>
</FrameLayout>
