<?xml version="1.0" encoding="utf-8"?>
<!--
  Where the OpenSubtitles API key is pasted.

  A dialog rather than an EditTextPreference because the explanation matters as much as the field:
  someone opening this has to be told that registration is free, that the key is theirs rather than
  the app's, and why Seamless does not simply ship one. An EditTextPreference gives a title and a
  box.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/explain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/settings_subtitle_key_message"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_subtitle_key_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
