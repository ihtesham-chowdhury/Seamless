<?xml version="1.0" encoding="utf-8"?>
<com.seamless.player.ui.player.PlayerGestureLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gesture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/player_controls"
        app:resize_mode="fit"
        app:shutter_background_color="@color/black"
        app:surface_type="texture_view"
        app:use_controller="true" />

    <!-- Leaves the player. Always present: from another app it returns you there. -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/circle_control_bg"
        android:contentDescription="@string/action_close"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:visibility="gone" />

    <!-- Rides with the transport controls: shown and hidden alongside them. -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Text rather than an icon: the current speed is the useful information. -->
        <TextView
            android:id="@+id/btn_speed"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/pill_control_bg"
            android:contentDescription="@string/playback_speed"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/shuffle"
            android:padding="12dp"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/btn_resize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/resize_mode"
            android:padding="12dp"
            android:src="@drawable/ic_aspect_ratio" />

        <!--
          Only on screen when the video actually has captions. A permanently greyed-out CC is a
          control that lies about what it can do; when there is nothing to show, the same thing
          lives in the overflow menu as "Subtitles", where "find me one" belongs anyway.
        -->
        <ImageButton
            android:id="@+id/btn_subtitles"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/subtitles"
            android:padding="12dp"
            android:src="@drawable/ic_closed_caption"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_lock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/lock"
            android:padding="12dp"
            android:src="@drawable/ic_lock" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/action_more"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!--
      What happened, once, without asking anything.

      This is the other half of applying a certain match automatically: a line of text that says
      what was done and offers to undo it, then leaves. A confirmation dialog before the fact
      would have interrupted the film to ask a question whose answer was already known; a silent
      change with no way back would have been worse.
    -->
    <LinearLayout
        android:id="@+id/subtitle_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginTop="86dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/hud_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/notice_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#A6FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notice_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/ripple_borderless_circle"
            android:letterSpacing="0.04"
            android:minHeight="36dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/action_undo"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- "2x >>" in a black capsule, the shape everyone already reads as press-and-hold. -->
    <TextView
        android:id="@+id/speed_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/speed_badge_bg"
        android:drawableEnd="@drawable/ic_fast_forward"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:letterSpacing="0.02"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:text="@string/speed_boost"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!--
      The volume / brightness level. Sits against whichever edge the gesture came from, so
      it appears under the thumb rather than across the middle of the picture.
    -->
    <com.seamless.player.ui.common.LevelHudView
        android:id="@+id/level_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hud_background"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/hud_background"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- No background: a lock must not put a grey wash over the video. -->
    <com.seamless.player.ui.common.LockOverlayView
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</com.seamless.player.ui.player.PlayerGestureLayout>
