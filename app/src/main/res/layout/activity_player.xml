<?xml version="1.0" encoding="utf-8"?>
<com.seamless.player.ui.player.PlayerGestureLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gesture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/player_controls"
        app:resize_mode="fit"
        app:shutter_background_color="@color/black"
        app:surface_type="texture_view"
        app:use_controller="true" />

    <!-- Leaves the player. Always present: from another app it returns you there. -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/circle_control_bg"
        android:contentDescription="@string/action_close"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:visibility="gone" />

    <!-- Rides with the transport controls: shown and hidden alongside them. -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/shuffle"
            android:padding="12dp"
            android:src="@drawable/ic_shuffle" />

        <!-- Text rather than an icon: the current speed is the useful information. -->
        <TextView
            android:id="@+id/btn_speed"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/pill_control_bg"
            android:contentDescription="@string/playback_speed"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_resize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/resize_mode"
            android:padding="12dp"
            android:src="@drawable/ic_aspect_ratio" />

        <!--
          Always here, and the only way in.

          It used to appear only once a video turned out to have captions, which meant "find me
          a subtitle" had to live in the overflow menu as well — the same thing in two places
          under the same name. A control that moves around teaches nobody where it is. The
          background is set from code, because it has three states and the accent that
          distinguishes them is a runtime value: see CcButton.
        -->
        <ImageButton
            android:id="@+id/btn_subtitles"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/subtitles"
            android:padding="12dp"
            android:src="@drawable/ic_closed_caption" />

        <ImageButton
            android:id="@+id/btn_lock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/lock"
            android:padding="12dp"
            android:src="@drawable/ic_lock" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_control_bg"
            android:contentDescription="@string/action_more"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!--
      What happened, once, without asking anything.

      This is the other half of applying a certain match automatically: a line that says what was
      done and offers to undo it, then leaves. A confirmation dialog before the fact would have
      interrupted the film to ask a question whose answer was already known; a silent change with
      no way back would have been worse.

      A floating pill, centred along the bottom and clear of the transport controls, in the same
      glass as the navigation capsule and the player's panels. It was a grey HUD box near the top
      with UNDO in capitals, which looked like a system toast that had wandered into the player.
      Undo is a small pill button of its own now — the one thing on the notice that can be
      pressed — and the notice rises in and fades away rather than appearing and vanishing.
    -->
    <LinearLayout
        android:id="@+id/subtitle_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="@dimen/notice_bottom_margin"
        android:background="@drawable/notice_pill_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <!-- A tick on its own disc of glass, the shape the transport buttons sit on. -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/notice_check_bg"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_check"
            app:tint="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/notice_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notice_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/notice_action_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/action_undo"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- "2x >>" in a black capsule, the shape everyone already reads as press-and-hold. -->
    <TextView
        android:id="@+id/speed_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/speed_badge_bg"
        android:drawableEnd="@drawable/ic_fast_forward"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:letterSpacing="0.02"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:text="@string/speed_boost"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!--
      The volume / brightness level. Sits against whichever edge the gesture came from, so
      it appears under the thumb rather than across the middle of the picture.
    -->
    <com.seamless.player.ui.common.LevelHudView
        android:id="@+id/level_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hud_background"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/hud_background"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- No background: a lock must not put a grey wash over the video. -->
    <com.seamless.player.ui.common.LockOverlayView
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</com.seamless.player.ui.player.PlayerGestureLayout>
