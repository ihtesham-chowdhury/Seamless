<?xml version="1.0" encoding="utf-8"?>
<!--
  About Seamless: the story, who wrote it, and a quiet footer.

      [x]
      SEAMLESS
      The story behind the player.

      Three paragraphs, in the developer's own words.

      —  Ihtesham Chowdhury
         developer
      ─────────────────────────
      VERSION     0.2.4
      BUILT WITH  Media3
      LICENCE     GPL-3.0 · View source
      PRIVACY     Offline by default. …

  The opening is deliberately modest — a small accent wordmark and a heading a size below a
  headline — so the story is the largest body of text on the page and the first thing read.
  The column stops at 560dp, so on a tablet or a phone on its side the lines stay a readable
  length instead of running the full width of the screen.

  Colours are the page_* pair in values and values-night, not the settings surfaces: this is a
  page to read, and in dark mode it sits on near black like the players do.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_ground">

    <!-- A faint wash of the accent from the top corner; painted by AboutActivity. -->
    <View
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="84dp"
                android:paddingEnd="30dp"
                android:paddingBottom="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="560dp">

                <TextView
                    android:id="@+id/wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.32"
                    android:text="@string/app_name"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:lineSpacingMultiplier="1.08"
                    android:text="@string/about_heading"
                    android:textColor="@color/page_ink"
                    android:textSize="26sp" />

                <!-- One view per paragraph, so the space between them is a margin rather than a
                     blank line at the story's own line height. -->
                <LinearLayout
                    android:id="@+id/story"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.42"
                        android:text="@string/about_story_problem"
                        android:textColor="@color/page_body"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:lineSpacingMultiplier="1.42"
                        android:text="@string/about_story_iphone"
                        android:textColor="@color/page_body"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:lineSpacingMultiplier="1.42"
                        android:text="@string/about_story_mission"
                        android:textColor="@color/page_body"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- The dash in a column of its own, so "developer" lines up under the name. -->
                <LinearLayout
                    android:id="@+id/signature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:paddingEnd="10dp"
                        android:text="@string/about_signature_dash"
                        android:textColor="@color/page_muted"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/about_signature_name"
                            android:textColor="@color/page_ink"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/about_signature_role"
                            android:textColor="@color/page_muted"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/rule"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="48dp"
                    android:background="@color/page_rule" />

                <!-- The footer: small capitals for the labels, and nothing louder than the story. -->
                <LinearLayout
                    android:id="@+id/footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="@string/about_version_label"
                            android:textAllCaps="true"
                            android:textColor="@color/page_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/version_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/page_body"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="@string/about_built_label"
                            android:textAllCaps="true"
                            android:textColor="@color/page_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_built_value"
                            android:textColor="@color/page_body"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/licence_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="@string/about_licence_label"
                            android:textAllCaps="true"
                            android:textColor="@color/page_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/licence_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/page_body"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="@string/about_privacy_label"
                            android:textAllCaps="true"
                            android:textColor="@color/page_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/about_privacy_value"
                            android:textColor="@color/page_body"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- The one way out, in the players' shape. The margin gains the status bar's height in code. -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/about_close_bg"
        android:contentDescription="@string/action_close"
        android:padding="13dp"
        android:src="@drawable/ic_close"
        app:tint="@color/page_ink" />
</FrameLayout>
