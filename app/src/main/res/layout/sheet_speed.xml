<?xml version="1.0" encoding="utf-8"?>
<!--
  Playback speed, as a floating card.

  The same card as the subtitle panel — inset from every edge, rounded all round — because it is
  the same kind of thing: a setting for what is playing, changed while it plays. It was an
  AlertDialog listing twelve numbers, which is the one shape nothing else in this player is. In
  landscape it sits in the middle of the screen; see FloatingSheet.Placement.

  Three ways to arrive at a speed, arranged by how precisely someone knows what they want:

      Playback speed                          ×
      ──────────────────────────────────────────
                       1.75×
          (−)  ━━━━━━━━━━━●━━━━━━━━━━━━  (+)
       [0.5] [0.75] [0.85] [ 1 ] [1.15] [1.25]
                            Normal
       [1.35] [1.5] [1.75] [ 2 ] [2.5] [ 3 ]

  The number, large, because it is the answer. The slider for "a bit faster", and a step either
  side of it for "exactly 1.1". The presets in two rows, slowest first, so every one of them is on
  screen at once: they scrolled sideways in a single row at first, and a row you have to scroll
  along hides the speed you came for off its end. The rows are built in code from the preset
  list, so adding a speed does not mean editing this file.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_glass_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_pad_horizontal"
        android:paddingTop="@dimen/sheet_pad_top"
        android:paddingEnd="@dimen/sheet_pad_horizontal"
        android:paddingBottom="@dimen/sheet_pad_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/playback_speed"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/sheet_title_size"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ripple_borderless_circle"
                android:contentDescription="@string/action_close"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="#8AFFFFFF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:background="#1FFFFFFF" />

        <!-- Tabular figures, so the number does not shuffle sideways as the slider moves. -->
        <TextView
            android:id="@+id/readout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_group_gap_tight"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/speed_readout_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/slower"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/speed_step_bg"
                android:contentDescription="@string/speed_slower"
                android:padding="10dp"
                android:src="@drawable/ic_speed_minus"
                app:tint="#FFFFFFFF" />

            <!--
              Hundredths, not the 0.25-3.0 it stands for. A Material Slider throws at layout if
              its range is not an exact multiple of its step, and float arithmetic does not
              promise that for 0.05; 25 to 300 in fives is exact.
            -->
            <com.google.android.material.slider.Slider
                android:id="@+id/slider"
                style="@style/Widget.Seamless.SheetSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:stepSize="5"
                android:valueFrom="25"
                android:valueTo="300" />

            <ImageButton
                android:id="@+id/faster"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/speed_step_bg"
                android:contentDescription="@string/speed_faster"
                android:padding="10dp"
                android:src="@drawable/ic_speed_plus"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <!-- The preset rows go in here; SpeedSheet builds them from the preset list. -->
        <LinearLayout
            android:id="@+id/presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_group_gap_tight"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>
</FrameLayout>
