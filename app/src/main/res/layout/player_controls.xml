<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces Media3's stock controller via app:controller_layout_id.

  exo_play_pause and exo_position are Media3's own ids: the controller finds them by name
  and drives them itself, and exo_play_pause must be an ImageView because it swaps the icon.
  They use @+id/ rather than @id/ so they declare-or-reuse and cannot fail to resolve.

  Previous and next are *not* exo ids on purpose. Media3's exo_prev / exo_next act on the
  player's own playlist, and this app feeds the player one item at a time from its own
  queue, so those buttons would do nothing. PlayerActivity wires these itself.

  controls_root is ours as well. PlayerActivity fades this whole layout in and out as one
  piece, which is only possible because Media3's own animation is switched off — see the
  note in PlayerActivity.wireButtons().

  Everything floats directly over the picture — no bars, no scrim. The transport buttons each sit
  on a disc of glass and nothing holds the three together: a capsule around them was tried, and
  however narrow it was made, it read as a bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/controls_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The only interactive part of the controller; the rest of controls_root is inert. -->
    <LinearLayout
        android:id="@+id/controls_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!--
          The transport, on glass.

          Three discs, the middle one larger and brighter, and nothing around them. A glass
          capsule holding all three was the first version, and it made the row read as a bar
          laid over the film — the very thing the rest of this player avoids. A disc under each
          button keeps what the capsule was for, saying where a touch lands, without the object
          that turned three controls into a strip.

          Sizes stay square so each oval-masked ripple is a circle and not an ellipse; the
          padding sets the glyph size inside its disc.
        -->
        <LinearLayout
            android:id="@+id/transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/transport_disc_bg"
                android:contentDescription="@string/action_previous"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous" />

            <!--
              scaleType="fitCenter" with no padding used to blow Media3's 24dp play glyph up to
              the full height of the button, which is why this one looked so unlike its
              neighbours. The padding is what keeps it in proportion with them.
            -->
            <ImageButton
                android:id="@+id/exo_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/transport_play_disc_bg"
                android:contentDescription="@null"
                android:padding="16dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/transport_disc_bg"
                android:contentDescription="@string/action_next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>

        <!-- Timeline, with elapsed on the left and time left on the right. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <!--
              Not a DefaultTimeBar. Media3 drives whatever view carries the id exo_progress
              so long as it implements TimeBar, which is what makes a completely different
              timeline possible without touching the controller. Which of the four it draws
              is a setting, applied by PlayerActivity once the controller has inflated.
            -->
            <com.seamless.player.ui.player.TimelineBar
                android:id="@+id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="30dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exo_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Not an exo_ id: the controller has no "time remaining" concept, so
                     PlayerActivity keeps this one updated itself. -->
                <TextView
                    android:id="@+id/time_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
