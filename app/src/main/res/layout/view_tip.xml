<?xml version="1.0" encoding="utf-8"?>
<!--
  A single contextual hint. Deliberately dark in both themes: it floats over library screens
  and over video alike, and one appearance that works everywhere beats two that each work in
  half the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tip_bg"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_tip" />

    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFF2F2F5"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/got"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/tip_got_it"
        android:textColor="#FFF2C230"
        app:rippleColor="#33F2C230" />
</LinearLayout>
