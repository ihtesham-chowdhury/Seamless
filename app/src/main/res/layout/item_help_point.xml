<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the guide: what you do, in a short bold line, then what happens.

  The glyph is shown only on rows about a button you can look for on screen, on the same disc a
  settings icon sits on; everywhere else the words are the whole row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="13dp"
    android:paddingEnd="18dp"
    android:paddingBottom="13dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/point_lead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/point_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <ImageView
        android:id="@+id/point_glyph"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:background="@drawable/pref_icon_chip"
        android:contentDescription="@null"
        android:padding="8dp"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
