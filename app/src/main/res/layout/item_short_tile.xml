<?xml version="1.0" encoding="utf-8"?>
<!--
  One clip in the shorts wall, in either masonry or grid.

  No filename. A wall of "VID_20240817_204411.mp4" is a wall of noise, and the frame is what
  tells one clip from another anyway — the name is available in list mode, which exists for
  exactly the people who want it.

  The height is set at bind time rather than here: masonry gives each tile its clip's own
  shape, grid gives every tile the same one. Both come from MediaStore's width and height, so
  a tile is measured before its thumbnail exists and nothing moves when it arrives.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#1F808080"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!--
              A scrim rather than a pill behind the duration. At this size a pill is a second
              rounded rectangle inside a rounded rectangle, which is exactly the stacking the
              rest of this screen avoids; a gradient that fades to nothing reads as part of
              the picture.
            -->
            <View
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_gravity="bottom"
                android:background="@drawable/tile_scrim" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="7dp"
                android:shadowColor="#B3000000"
                android:shadowRadius="3"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/favourite"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="7dp"
                android:contentDescription="@string/action_favourite"
                android:src="@drawable/ic_heart_badge"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
