<?xml version="1.0" encoding="utf-8"?>
<!--
  A frame around the preference list, so this tab has a header like the other two.

  PreferenceFragmentCompat builds its own view and has nowhere to put one, so the fragment
  inflates this and drops the preference list into it underneath.

  Two plain TextViews rather than a MaterialToolbar, and for a reason that has already cost
  this project a bug once: a toolbar measures its title and subtitle as one vertical group and
  centres that group in its own bounds, and at Material 3 sizes the group is taller than
  ?attr/actionBarSize — so the title is pushed off the top edge and simply does not appear.
  That is what happened to the Shorts header, and this is the same shape as the fix.

  The subtitle is one line on purpose. Settings is a utility screen; it needs air before the
  first section, not a hero area.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingTop="20dp"
        android:paddingEnd="34dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:text="@string/settings_header_subtitle"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</LinearLayout>
