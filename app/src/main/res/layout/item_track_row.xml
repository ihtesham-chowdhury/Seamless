<?xml version="1.0" encoding="utf-8"?>
<!--
  One selectable track: a radio, a language, where it came from, and a way to be rid of it.

  A radio rather than a tick. A tick means "done"; what this row means is "this one, of these",
  and an unselected row still has to show that it *could* be chosen — an empty ring says that
  and a blank space does not. The two radio drawables share a ring, so only the centre changes
  when the selection moves and nothing shifts sideways.

  Origin goes on the second line rather than in a chip, because it is the thing that
  distinguishes two rows both labelled "English", and a chip would make it look like a warning.

  The delete button is there for any subtitle that is a file: one this app downloaded, and one
  sitting beside the video in a folder it has been given. Not for a track inside the video,
  which has no file of its own. It is drawn quietly — thin, faint, at the far edge where a
  thumb reaching for the row does not land — and it asks first when the file is one the user
  put there themselves.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple_sheet_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/sheet_row_height"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/tick"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_radio_off" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/sheet_label_size" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8AFFFFFF"
            android:textSize="@dimen/sheet_detail_size" />
    </LinearLayout>

    <!-- 40dp of touch target around an 18dp glyph: quiet to look at, ordinary to hit. -->
    <ImageButton
        android:id="@+id/remove"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/ripple_borderless_circle"
        android:contentDescription="@string/subtitle_remove"
        android:padding="11dp"
        android:src="@drawable/ic_delete_subtitle"
        android:visibility="gone"
        app:tint="#8AFFFFFF" />
</LinearLayout>
