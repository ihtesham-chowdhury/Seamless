<?xml version="1.0" encoding="utf-8"?>
<!--
  The three tabs, as a capsule floating over the content rather than a bar cutting the
  screen in two.

  This is not a BottomNavigationView. That view is a full-width surface by definition — it
  measures its items across the whole width and paints its own background edge to edge — and
  every route to making it a narrow floating pill fights its own measuring. Three rows of
  icon and label with a shared background is a small enough thing to build outright, and
  building it means the selected state, the capsule behind it and the glass are all under
  this app's control instead of Material's.

  Content sits behind it, full height. The lists inside each tab reserve room at the bottom
  so nothing is permanently hidden, and what scrolls past shows through the glass.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      Wider than three tabs strictly need, and still well short of the screen's edges.

      It was as narrow as its tabs, which made it read as a small badge sitting at the bottom
      rather than as the way around the app. The other extreme, edge to edge, is a bar again,
      which is what this capsule exists not to be. So it takes the width less a generous margin
      either side and stops at a cap, and the three tabs share it equally: on a phone held upright
      that is most of the width, and on a wide screen it stays a capsule in the middle instead of
      stretching into a strip.
    -->
    <LinearLayout
        android:id="@+id/nav_pill"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_pill_height"
        android:layout_marginStart="@dimen/nav_pill_side_margin"
        android:layout_marginEnd="@dimen/nav_pill_side_margin"
        android:layout_marginBottom="@dimen/nav_pill_margin"
        android:background="@drawable/glass_nav_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/nav_pill_max_width">

        <LinearLayout
            android:id="@+id/nav_library"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/nav_item_bg"
            android:clickable="true"
            android:contentDescription="@string/tab_library"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder"
                android:tint="@color/nav_item_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_library"
                android:textColor="@color/nav_item_tint"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_shorts"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/nav_item_bg"
            android:clickable="true"
            android:contentDescription="@string/tab_shorts"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shorts"
                android:tint="@color/nav_item_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_shorts"
                android:textColor="@color/nav_item_tint"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/nav_item_bg"
            android:clickable="true"
            android:contentDescription="@string/tab_settings"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                android:tint="@color/nav_item_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_settings"
                android:textColor="@color/nav_item_tint"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
