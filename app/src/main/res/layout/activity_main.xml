<?xml version="1.0" encoding="utf-8"?>
<!--
  The three tabs, as a capsule floating over the content rather than a bar cutting the
  screen in two.

  This is not a BottomNavigationView. That view is a full-width surface by definition — it
  measures its items across the whole width and paints its own background edge to edge — and
  every route to making it a narrow floating pill fights its own measuring. Three tabs of icon
  and name inside a view that lays them out itself is a small enough thing to build outright,
  and building it means the selection, the capsule and the glass are all under this app's
  control instead of Material's.

  Content sits behind it, full height. The lists inside each tab reserve room at the bottom
  so nothing is permanently hidden, and what scrolls past shows through the glass.

  clipChildren is off on the root so the liquid style's drop of glass can swell past the capsule's
  edge when it lifts, and so no shadow is cut to a hard line.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- An ordinary frame for the tabs, which can also hand what it draws to the glass. -->
    <com.seamless.player.ui.nav.BackdropFrame
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The navigation capsule.

      How it looks is decided in FloatingNavBar, from the setting: frosted glass, the accent
      island, or liquid glass. What is declared here is only what the three share — three tabs,
      each an icon and a name, and where the capsule sits. Its height comes from the style, so the
      layout asks for wrap_content; its width is the screen less a margin either side, up to a cap,
      and the frosted capsule is narrower still and centred within that.

      The icons and names carry no colour of their own. Their ink changes continuously as the
      selection passes over them, which a colour state list cannot express.
    -->
    <com.seamless.player.ui.nav.FloatingNavBar
        android:id="@+id/nav_pill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nav_pill_side_margin"
        android:layout_marginEnd="@dimen/nav_pill_side_margin"
        android:layout_marginBottom="@dimen/nav_pill_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/nav_pill_max_width">

        <com.seamless.player.ui.nav.NavTabView
            android:id="@+id/nav_library"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/tab_library"
            android:focusable="true">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_library" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/tab_library"
                android:textSize="11sp" />
        </com.seamless.player.ui.nav.NavTabView>

        <com.seamless.player.ui.nav.NavTabView
            android:id="@+id/nav_shorts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/tab_shorts"
            android:focusable="true">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_shorts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/tab_shorts"
                android:textSize="11sp" />
        </com.seamless.player.ui.nav.NavTabView>

        <com.seamless.player.ui.nav.NavTabView
            android:id="@+id/nav_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/tab_settings"
            android:focusable="true">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/tab_settings"
                android:textSize="11sp" />
        </com.seamless.player.ui.nav.NavTabView>
    </com.seamless.player.ui.nav.FloatingNavBar>
</androidx.constraintlayout.widget.ConstraintLayout>
