<?xml version="1.0" encoding="utf-8"?>
<!--
  The three tabs, as a capsule floating over the content rather than a bar cutting the
  screen in two.

  This is not a BottomNavigationView. That view is a full-width surface by definition — it
  measures its items across the whole width and paints its own background edge to edge — and
  every route to making it a narrow floating pill fights its own measuring. Three rows of
  icon and label with a shared background is a small enough thing to build outright, and
  building it means the selected state, the capsule behind it and the glass are all under
  this app's control instead of Material's.

  Content sits behind it, full height. The lists inside each tab reserve room at the bottom
  so nothing is permanently hidden, and what scrolls past shows through the glass.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The navigation capsule: a glass surface, and a single island of the accent colour that slides
      to whichever tab you are on.

      Wider than three tabs strictly need, and still well short of the screen's edges. As narrow as
      its tabs it read as a small badge rather than as the way around the app; edge to edge it would
      be a bar again, which is what a capsule is for not being. So it takes the width less a margin
      either side, stops at a cap, and the three tabs share it equally.

      The island is one view behind all three tabs rather than a background on each, and that is
      what lets it travel: choosing another tab moves the same island across, so the change reads
      as the selection moving rather than as one capsule switching off and another switching on. It
      carries a soft highlight along its top and a glow of its own colour beneath it; the shadow is
      tinted, which needs API 28, and this app starts at 29.

      Two details that are not decoration. clipChildren is off so the glow can spill into the
      capsule's padding instead of stopping at a hard edge. And the row of tabs has the same
      elevation as the island: views are drawn in order of elevation first, so a row at zero would
      be painted underneath the island and the selected tab's icon and label would disappear.
    -->
    <FrameLayout
        android:id="@+id/nav_pill"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_pill_height"
        android:layout_marginStart="@dimen/nav_pill_side_margin"
        android:layout_marginEnd="@dimen/nav_pill_side_margin"
        android:layout_marginBottom="@dimen/nav_pill_margin"
        android:background="@drawable/glass_nav_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:outlineAmbientShadowColor="#66000000"
        android:outlineSpotShadowColor="#99000000"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/nav_pill_max_width">

        <!--
          Sized and positioned from MainActivity once the tabs have widths. Gravity is left rather
          than start: the island is placed by the tab's left coordinate, which is absolute, and a
          start gravity would put it at the right-hand end in a right-to-left layout before any
          translation was applied.
        -->
        <View
            android:id="@+id/nav_island"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:background="@drawable/nav_island_bg"
            android:elevation="4dp"
            android:outlineAmbientShadowColor="@color/nav_island"
            android:outlineSpotShadowColor="@color/nav_island"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/nav_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_library"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_bg"
                android:clickable="true"
                android:contentDescription="@string/tab_library"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/nav_item_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/tab_library"
                    android:textColor="@color/nav_item_tint"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_shorts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_bg"
                android:clickable="true"
                android:contentDescription="@string/tab_shorts"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shorts"
                    android:tint="@color/nav_item_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/tab_shorts"
                    android:textColor="@color/nav_item_tint"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_bg"
                android:clickable="true"
                android:contentDescription="@string/tab_settings"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/nav_item_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/tab_settings"
                    android:textColor="@color/nav_item_tint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
