<?xml version="1.0" encoding="utf-8"?>
<!--
  How subtitles look, in one screenful.

  Five controls, and stopping at five is the point. Every other player's caption settings screen
  is a font picker, four colour pickers and an opacity slider for each of them, which is a lot of
  work to arrive back at what the defaults should have been. What is here is what people actually
  reach for: bigger, bolder, further up, and a box if they really want one.

  Everything applies as it moves, and the subtitle itself is lifted to the middle of the picture
  while this panel is open so the effect is visible rather than hidden behind it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_glass_bg"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/sheet_grabber" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/subtitle_appearance"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/subtitle_size"
            android:textAppearance="@style/TextAppearance.Seamless.SheetLabel" />

        <!--
          Whole numbers, not the 0.7–1.8 multiplier they stand for.

          A Material Slider throws at layout if (valueTo - valueFrom) is not an exact multiple
          of stepSize, and 1.8 - 0.7 is 1.1000001 in float arithmetic, which is not an exact
          multiple of 0.1. Percent in, percent out, divided by a hundred in code.
        -->
        <com.google.android.material.slider.Slider
            android:id="@+id/size"
            style="@style/Widget.Seamless.SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="70"
            android:valueTo="180" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/subtitle_weight"
            android:textAppearance="@style/TextAppearance.Seamless.SheetLabel" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/weight_normal"
                style="@style/Widget.Seamless.SheetToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtitle_weight_normal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/weight_bold"
                style="@style/Widget.Seamless.SheetToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtitle_weight_bold" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/subtitle_edge"
            android:textAppearance="@style/TextAppearance.Seamless.SheetLabel" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/edge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edge_outline"
                style="@style/Widget.Seamless.SheetToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtitle_edge_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edge_shadow"
                style="@style/Widget.Seamless.SheetToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtitle_edge_shadow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edge_none"
                style="@style/Widget.Seamless.SheetToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtitle_edge_none" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/subtitle_background"
            android:textAppearance="@style/TextAppearance.Seamless.SheetLabel" />

        <com.google.android.material.slider.Slider
            android:id="@+id/background"
            style="@style/Widget.Seamless.SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/subtitle_position"
            android:textAppearance="@style/TextAppearance.Seamless.SheetLabel" />

        <com.google.android.material.slider.Slider
            android:id="@+id/position"
            style="@style/Widget.Seamless.SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="2"
            android:valueTo="30" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/Widget.Seamless.SheetToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:text="@string/subtitle_appearance_reset" />
    </LinearLayout>
</FrameLayout>
