<?xml version="1.0" encoding="utf-8"?>
<!--
  One settings row, last row of a group.

  A replacement for androidx's preference_material, which paints no background of its own and
  leaves every row looking like an item in one long list. Grouping the rows into cards is
  what makes a settings screen scannable: the heading says what the group is for, and the
  card says where the group ends.

  The ids are not negotiable. Preference binds by @android:id/title, @android:id/summary,
  @android:id/icon and @android:id/widget_frame, and looks for the icon's wrapper by the name
  icon_frame — androidx's own id, which resolves to the same entry as @+id/icon_frame here
  because library resources merge into this package by name. widget_frame has to be a
  ViewGroup: the switch or the seek bar is inflated into it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/pref_group_bottom"
    android:baselineAligned="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!--
      The icon, on a disc: the same round plate the player's controls sit on, at the size of a
      row. The disc is the frame's background rather than the icon's, because Preference shows
      and hides icon_frame by whether the row has an icon, and a disc left on a row without one
      would be an empty circle.
    -->
    <LinearLayout
        android:id="@+id/icon_frame"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/pref_icon_chip"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/pref_title" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="4"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/pref_summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end|center_vertical"
        android:orientation="vertical" />
</LinearLayout>
